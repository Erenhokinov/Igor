set $mod Mod4

exec_always --no-startup-id swaybg -c #0c0c0a

set $left h
set $down j
set $up k
set $right l
set $term alacritty
set $menu rofi -show drun

input "type:pointer" {
    accel_profile "flat"
    pointer_accel -0.5
}

input "type:keyboard" {
    xkb_layout us,ru
    xkb_options grp:alt_shift_toggle
}

font pango:Inter Regular 9

gaps inner 4
gaps outer 2
smart_gaps on
smart_borders on

default_border pixel 1
default_floating_border pixel 1

default_dim_inactive 0.05

for_window [app_id="alacritty"] opacity 0.95

#                        border    bg        text      indicator child_border
client.focused           #e8e0d8   #1c1c1a   #f0ece8   #b8b0a8   #e8e0d8
client.unfocused         #2c2c2a   #111110   #686460   #2c2c2a   #2c2c2a
client.focused_inactive  #2c2c2a   #161614   #888480   #2c2c2a   #2c2c2a
client.urgent            #cc4444   #1a0a0a   #f0ece8   #cc4444   #cc4444
client.background        #0c0c0a

for_window [window_type="dialog"] floating enable, move position center
for_window [window_role="pop-up"]  floating enable
for_window [app_id="confirm"]      floating enable, move position center

floating_mod $mod
focus_follows_mouse yes

bindsym $mod+Return exec $term
bindsym $mod+d exec $menu
bindsym $mod+q kill
bindsym Print exec grim - | wl-copy
bindsym $mod+Shift+c reload
bindsym $mod+Shift+e exec swaynag -t warning -m 'Exit Sway?' -B 'Yes.' "swaymsg exit"

bindsym $mod+1 workspace number 1
bindsym $mod+2 workspace number 2
bindsym $mod+3 workspace number 3
bindsym $mod+4 workspace number 4
bindsym $mod+5 workspace number 5
bindsym $mod+6 workspace number 6

bindsym $mod+Shift+1 move container to workspace number 1
bindsym $mod+Shift+2 move container to workspace number 2
bindsym $mod+Shift+3 move container to workspace number 3
bindsym $mod+Shift+4 move container to workspace number 4
bindsym $mod+Shift+5 move container to workspace number 5
bindsym $mod+Shift+6 move container to workspace number 6

bindsym $mod+f fullscreen toggle
bindsym $mod+space floating toggle

bindsym $mod+$left focus left
bindsym $mod+$down focus down
bindsym $mod+$up   focus up
bindsym $mod+$right focus right

bindsym $mod+Shift+$left move left
bindsym $mod+Shift+$down move down
bindsym $mod+Shift+$up   move up
bindsym $mod+Shift+$right move right

exec_always --no-startup-id waybar

bar {
    swaybar_command swaybar
}
